{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["direction", "groups"],
  "properties": {
    "direction": { "type": "string", "enum": ["gainer", "loser"] },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "category", "members", "preliminaryStory", "queryHints"],
        "properties": {
          "slug": { "type": "string" },
          "category": { "type": "string" },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "name", "pct"],
              "properties": {
                "code": { "type": "string" },
                "name": { "type": "string" },
                "pct": { "type": "number" }
              }
            }
          },
          "preliminaryStory": { "type": "string" },
          "queryHints": { "type": "array", "items": { "type": "string" }, "maxItems": 4 }
        }
      }
    }
  }
}
