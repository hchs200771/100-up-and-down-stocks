{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "factors:audit": "node --import tsx scripts/audit-factor-evidence.ts",
    "backtest:picks:fetch": "node --import tsx scripts/fetch-pick-backtest-inputs.ts",
    "backtest:picks": "node --import tsx scripts/backtest-pick-filters.ts",
    "backtest:expanded:fetch": "node --import tsx scripts/fetch-expanded-backtest-inputs.ts",
    "backtest:expanded": "node --import tsx scripts/backtest-price-market-events.ts",
    "report": "bash scripts/run-daily-report-auto.sh",
    "report:codex": "bash scripts/run-daily-report-codex-parallel.sh",
    "report:claude": "bash scripts/run-daily-report-claude.sh",
    "report:fetch": "tsx scripts/fetch-market-data.ts",
    "report:send": "tsx scripts/send-report.ts",
    "report:score": "tsx scripts/score-report.ts",
    "report:picks": "tsx scripts/build-stock-picks.ts",
    "positions": "tsx scripts/analyze-positions.ts",
    "screen:cb": "tsx scripts/screen-cb-pledge.ts",
    "backtest:wide:fetch": "python3 scripts/fetch-wide-market-history.py",
    "backtest:wide": "node --import tsx scripts/backtest-wide-market.ts",
    "backtest:wide:actions": "python3 scripts/fetch-wide-action-references.py",
    "backtest:restore": "python3 scripts/restore-backtest-checkpoint.py",
    "backtest:wide:render": "node --import tsx scripts/render-wide-backtest-report.ts"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "opencc-js": "^1.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
